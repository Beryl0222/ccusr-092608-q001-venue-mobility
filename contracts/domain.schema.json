{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "分散赛区通行保障台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "FACT_REGISTERED",
        "SCHEDULE_FROZEN",
        "DEMAND_SUBMITTED",
        "FACT_CONFIRMED",
        "CLEARANCE_ISSUED",
        "ROUTE_REVISED",
        "CAPACITY_HELD",
        "CAPACITY_RELEASED",
        "EMERGENCY_RELEASED",
        "EMERGENCY_RATIFIED",
        "DEPARTED",
        "NO_SHOW_RELEASED",
        "ARRIVAL_CONFIRMED",
        "ESCALATED",
        "DEMAND_ISOLATED",
        "CASE_OPENED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "fact_catalog",
        "travel_demand",
        "route_revision",
        "capacity_commitment",
        "arrival_case"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "payload_required_by_event": {
    "FACT_REGISTERED": [
      "fact_kind",
      "fact_key",
      "fact_version",
      "snapshot"
    ],
    "SCHEDULE_FROZEN": [
      "schedule_version",
      "road_version"
    ],
    "DEMAND_SUBMITTED": [
      "requester",
      "category",
      "headcount",
      "accessibility_seats",
      "origin_ref",
      "venue_ref",
      "needed_at",
      "facts"
    ],
    "FACT_CONFIRMED": [
      "role",
      "confirmation_key",
      "claims"
    ],
    "CLEARANCE_ISSUED": [
      "schedule_version",
      "road_version",
      "itinerary",
      "checkpoints",
      "access"
    ],
    "ROUTE_REVISED": [
      "impact_scope",
      "effective_at"
    ],
    "CAPACITY_HELD": [
      "resource_ref",
      "quantity"
    ],
    "CAPACITY_RELEASED": [
      "resource_ref",
      "quantity",
      "reason"
    ],
    "EMERGENCY_RELEASED": [
      "revision_id",
      "resource_ref",
      "quantity",
      "review_due_at",
      "reason"
    ],
    "EMERGENCY_RATIFIED": [
      "revision_id"
    ],
    "DEPARTED": [
      "departed_at"
    ],
    "NO_SHOW_RELEASED": [
      "resource_ref",
      "quantity",
      "released_at"
    ],
    "ARRIVAL_CONFIRMED": [
      "arrived_at"
    ],
    "ESCALATED": [
      "to_role",
      "reason"
    ],
    "DEMAND_ISOLATED": [
      "reused_key",
      "held_fingerprint",
      "incoming_fingerprint"
    ],
    "CASE_OPENED": [
      "demand_id",
      "opened_at",
      "reason"
    ]
  },
  "additionalProperties": false
}
